<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        WRITE_EXTERNAL_STORAGE solo hace falta hasta Android 9 (API 28).
        Desde Android 10 en adelante el sistema maneja permisos de almacenamiento
        de forma diferente — por eso el maxSdkVersion="28".
        Como tu minSdk es 26, lo dejamos para cubrir Android 8 y 9.
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="web-production-f82cf.up.railway.app"
                    android:pathPrefix="/auth/reset-password" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.candlelabs.gestionpersonal"
                    android:host="reset-password" />
            </intent-filter>
        </activity>

        <!--
            FileProvider — componente del sistema que convierte rutas de archivo en URIs seguras.
            Sin esto, si intentás compartir un archivo con otra app usando su ruta directa,
            Android lanza FileUriExposedException en runtime (desde API 24).

            authorities: tiene que ser único en el dispositivo → usamos packageName + ".provider"
            exported="false": solo nuestra app puede pedirle URIs al FileProvider
            grantUriPermissions="true": le da permiso TEMPORAL de lectura a la app que recibe el Intent
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.candlelabs.gestionpersonal.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
    <!-- Limitar a pantallas de celular -->
    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="false"
        android:xlargeScreens="false"
        android:anyDensity="true" />

    <!-- Requerir pantalla táctil (excluye Chromebooks sin touch) -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />


</manifest>
